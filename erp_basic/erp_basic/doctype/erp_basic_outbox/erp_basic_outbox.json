    },
    {
      "fieldname": "result",
      "label": "Result",
      "fieldtype": "Long Text"
    },
    {
      "fieldname": "correlation_id",
      "label": "Correlation UUID",
      "fieldtype": "Data"
    },
    {
      "fieldname": "causation_id",
      "label": "Causation UUID",
      "fieldtype": "Data"
    },
    {
      "fieldname": "erp_doctype",
      "label": "ERP DocType",
      "fieldtype": "Link",
      "options": "DocType"
    },
    {
      "fieldname": "erp_name",
      "label": "ERP document",
