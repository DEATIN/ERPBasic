    },
    {
      "fieldname": "result",
      "label": "Result",
      "fieldtype": "Long Text"
    },
    {
      "fieldname": "correlation_id",
      "label": "Correlation UUID",
      "fieldtype": "Data"
    },
    {
      "fieldname": "causation_id",
      "label": "Causation UUID",
